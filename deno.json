{
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-sys scripts/build.mjs",
    "dev": "WIKI_SITE_ORIGIN=http://localhost:8000 deno run --allow-read --allow-write --allow-env --allow-sys --watch=entries,categories,template,index.md,template.html,styles-base.css,styles-code-light.css,styles-code-dark.css scripts/build.mjs",
    "serve": "deno run --allow-read --allow-net --allow-sys jsr:@std/http@1/file-server --port 8000 out",
    "init-site": "deno run --allow-read --allow-write --allow-env --allow-sys scripts/init-site.mjs",
    "upgrade-program": "deno run --allow-read --allow-write --allow-env --allow-sys scripts/upgrade-program.mjs",
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys test/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "marked": "npm:marked@16.4.2",
    "marked-alert": "npm:marked-alert@2.1.2",
    "marked-footnote": "npm:marked-footnote@1.4.0",
    "highlight.js": "npm:highlight.js@11.11.1"
  },
  "fmt": {
    "exclude": ["out/", "node_modules/", "test/golden.manifest.json", "entries/", "categories/", "template/", "*.md"]
  },
  "lint": {
    "include": ["scripts/", "test/"]
  }
}
